{
  "name": "moka",
  "version": "1.0.0",
  "private": true,
  "description": "A very cute Go-playing model",
  "homepage": "https://million.dev/moka",
  "license": "MIT",
  "author": {
    "name": "Million",
    "url": "https://million.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/millionco/moka.git"
  },
  "files": [
    "dist",
    "model",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./model.bin": "./model/go-model.bin",
    "./model.json": "./model/go-model.json",
    "./worker": "./dist/worker.js",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "vp pack",
    "test": "uv run python tests/board.py && uv run python tests/features.py && uv run python tests/symmetry.py && uv run python tests/collect.py",
    "check": "vp check",
    "check:fix": "vp check --fix"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5",
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.2.6",
    "vite-plus": "latest"
  },
  "packageManager": "pnpm@11.17.0"
}
